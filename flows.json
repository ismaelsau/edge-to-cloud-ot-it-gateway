    {
        "id": "fn_procesar_datos",
        "type": "function",
        "z": "tab_iiot_ismael",
        "name": "Desglosar Variables",
        "func": "let data = msg.payload;\n\n// Mensaje para el Gauge de Temperatura\nlet msgTemp = { payload: data.temperature };\n\n// Mensaje para el Gauge de Humedad\nlet msgHum = { payload: data.humidity };\n\n// Mensaje para el Estado Operativo\nlet msgStatus = { payload: data.status };\n\nreturn [msgTemp, msgHum, msgStatus];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 240,
        "wires": [
            [
                "ui_gauge_temp"
            ],
            [
                "ui_gauge_hum"
            ],
            [
                "ui_text_status"
            ]
        ]
