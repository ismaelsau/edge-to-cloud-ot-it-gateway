        "id": "313da1de9fa721c6",
        "type": "function",
        "z": "tab_iiot_ismael",
        "name": "Formatear para supabase",
        "func": "let data = msg.payload;\n\nmsg.headers = {\n    \"apikey\": \"Bearer TU_ANON_KEY\",\n    \"Authorization\": \"Bearer sb_p...\",\n    \"Content-Type\": \"application/json\",\n    \"Prefer\": \"return=minimal\"\n};\n\nmsg.payload = {\n    \"sensor_id\": \"ESP32_TALLER_01\",\n    \"temperature\": data.temperature,\n    \"humidity\": data.humidity,\n    \"status\": data.status\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
